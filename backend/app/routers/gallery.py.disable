from fastapi import (
    APIRouter,
    Depends,
    HTTPException,
    status,
    UploadFile,
    File,
    Form
)

from sqlalchemy.orm import Session
from typing import List


from app.database.connection import get_db

from app.schemas.gallery import (
    GalleryResponse
)

from app.services.gallery import (
    GalleryService
)



router = APIRouter(

    prefix="/gallery",

    tags=[
        "Gallery"
    ]

)





# =====================================================
# CREATE GALLERY ITEM
# POST /api/v1/gallery/
# =====================================================


@router.post(

    "/",

    response_model=GalleryResponse,

    status_code=status.HTTP_201_CREATED

)
def create_gallery(

    title: str = Form(...),

    category: str = Form(...),

    file: UploadFile = File(...),

    db: Session = Depends(get_db)

):


    try:


        return GalleryService.create_gallery_item(

            db,

            title,

            category,

            file

        )


    except Exception as error:


        raise HTTPException(

            status_code=500,

            detail=str(error)

        )






# =====================================================
# GET ALL GALLERY
# GET /api/v1/gallery/
# =====================================================


@router.get(

    "/",

    response_model=List[GalleryResponse]

)
def get_gallery(

    db: Session = Depends(get_db)

):


    return GalleryService.get_gallery_items(

        db

    )






# =====================================================
# GET SINGLE GALLERY
# GET /api/v1/gallery/{id}
# =====================================================


@router.get(

    "/{gallery_id}",

    response_model=GalleryResponse

)
def get_gallery_by_id(

    gallery_id:int,

    db:Session = Depends(get_db)

):


    gallery = GalleryService.get_gallery_by_id(

        db,

        gallery_id

    )


    if not gallery:


        raise HTTPException(

            status_code=404,

            detail="Gallery item not found"

        )


    return gallery






# =====================================================
# DELETE GALLERY
# DELETE /api/v1/gallery/{id}
# =====================================================


@router.delete(

    "/{gallery_id}"

)
def delete_gallery(

    gallery_id:int,

    db:Session = Depends(get_db)

):


    result = GalleryService.delete_gallery(

        db,

        gallery_id

    )


    if not result:


        raise HTTPException(

            status_code=404,

            detail="Gallery item not found"

        )


    return {

        "message":
        "Gallery deleted successfully"

    }