
"""
DISABLED FILE

Gallery Admin APIs are handled inside:
app/api/admin.py

Do not register this router in main.py
"""
from fastapi import (
    APIRouter,
    Depends,
    HTTPException,
    UploadFile,
    File,
    Form
)

from sqlalchemy.orm import Session

from pathlib import Path

import shutil
import uuid
import os


from app.database.connection import get_db

from app.models.gallery import GalleryModel

from app.utils.dependencies import get_current_admin

from app.config.settings import settings





router = APIRouter(

    prefix="/admin/gallery",

    tags=[

        "Admin Gallery Management"

    ]

)




UPLOAD_PATH = Path(

    settings.UPLOAD_DIRECTORY

)


UPLOAD_PATH.mkdir(

    parents=True,

    exist_ok=True

)






# =====================================================
# UPLOAD GALLERY IMAGE
# POST /api/v1/admin/gallery/upload
# =====================================================


@router.post("/upload")
def upload_gallery(

    title:str = Form(...),

    category:str = Form(...),

    description:str = Form(None),

    file:UploadFile = File(...),

    db:Session = Depends(get_db),

    admin=Depends(get_current_admin)

):


    allowed_types = [

        "image/jpeg",

        "image/png",

        "image/webp"

    ]



    if file.content_type not in allowed_types:


        raise HTTPException(

            400,

            "Only jpg png webp allowed"

        )




    filename = (

        str(uuid.uuid4())

        +

        "_"

        +

        file.filename

    )



    file_path = UPLOAD_PATH / filename




    with open(file_path,"wb") as buffer:


        shutil.copyfileobj(

            file.file,

            buffer

        )





    image_url = (

        f"/static/uploads/gallery/{filename}"

    )



    gallery = GalleryModel(

        title=title,

        category=category,

        description=description,

        image_url=image_url

    )



    db.add(gallery)

    db.commit()

    db.refresh(gallery)



    return {


        "status":"success",

        "message":

        "Image uploaded successfully",

        "data":gallery

    }








# =====================================================
# ADMIN GALLERY LIST
# GET /api/v1/admin/gallery
# =====================================================


@router.get("/")
def admin_gallery_list(

    db:Session=Depends(get_db),

    admin=Depends(get_current_admin)

):


    data=(

        db.query(GalleryModel)

        .filter(

            GalleryModel.is_deleted==False

        )

        .order_by(

            GalleryModel.id.desc()

        )

        .all()

    )


    return {


        "status":"success",

        "count":len(data),

        "data":data

    }








# =====================================================
# DELETE GALLERY IMAGE
# DELETE /api/v1/admin/gallery/{id}
# =====================================================


@router.delete("/{gallery_id}")
def delete_gallery(

    gallery_id:int,

    db:Session=Depends(get_db),

    admin=Depends(get_current_admin)

):


    gallery=(

        db.query(GalleryModel)

        .filter(

            GalleryModel.id==gallery_id

        )

        .first()

    )



    if not gallery:


        raise HTTPException(

            404,

            "Gallery item not found"

        )




    if gallery.image_url:


        filename=os.path.basename(

            gallery.image_url

        )


        path=UPLOAD_PATH / filename



        if path.exists():

            path.unlink()



    gallery.is_deleted=True



    db.commit()



    return {


        "status":"success",

        "message":

        "Gallery deleted successfully"

    }